{
  "name": "dependency-radar",
  "version": "1.1.1",
  "description": "Local-first dependency analysis tool that generates a single HTML report showing risk, size, usage, and structure of your project's dependencies.",
  "bin": {
    "dependency-radar": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev:report": "cd report-ui && npx vite",
    "update:spdx": "tsx scripts/build-spdx.ts",
    "update:replacements": "tsx scripts/build-replacements.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p report-ui/tsconfig.json",
    "build:report-ui": "cd report-ui && npx vite build",
    "build:report": "npm run build:report-ui && tsx scripts/build-report.ts",
    "build": "npm run clean && npm run build:report && tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts scan",
    "scan": "node dist/cli.js scan",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:schemas": "tsx scripts/validate-output-schemas.ts",
    "test:fixtures": "npm --prefix test-fixtures run test",
    "test:fixtures:online": "npm --prefix test-fixtures run test:online",
    "test:fixtures:all": "npm --prefix test-fixtures run test:all",
    "test:docker:node14": "node scripts/test-docker-node14.js",
    "test:docker": "npm run test:docker:node14",
    "test:pack": "node scripts/check-pack.js",
    "test:release:ok": "node -e \"console.log('\\n✅ test:release passed')\"",
    "test:release": "npm run build && npm run test:unit && npm run test:schemas && npm run test:fixtures:all && npm run test:docker && npm run test:pack && npm run test:release:ok",
    "prepublishOnly": "npm run build"
  },
  "author": "Joseph Maynard",
  "license": "MIT",
  "engines": {
    "node": ">=14.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JosephMaynard/dependency-radar.git"
  },
  "homepage": "https://www.dependency-radar.com",
  "bugs": {
    "url": "https://github.com/JosephMaynard/dependency-radar/issues"
  },
  "keywords": [
    "dependency",
    "dependencies",
    "analysis",
    "audit",
    "security",
    "license",
    "cli",
    "report",
    "scan",
    "npm",
    "node",
    "html",
    "maintenance",
    "deprecated",
    "unmaintained"
  ],
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ajv": "^8.18.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "terser": "^5.49.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@10.9.2"
}
